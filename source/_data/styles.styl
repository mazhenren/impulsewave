// NexT 自定义样式：返回顶部按钮固定右下角
.back-to-top {
  left: auto;
  right: 30px;
  bottom: 30px;
}

// 侧栏站点概览：隐藏"分类"计数（页面与文章分类字段保持不变）
.site-state-item.site-state-categories {
  display: none;
}

// 文章 meta 中的浏览量徽章
.post-views-badge {
  height: 18px;
  vertical-align: middle;
}

// ===== 星球信息流（/planet/） =====
.planet-toolbar
  display flex
  flex-wrap wrap
  gap 8px
  justify-content space-between
  align-items center
  margin-bottom 12px

.planet-cats
  display flex
  flex-wrap wrap
  gap 6px

.planet-tools
  display flex
  gap 8px
  align-items center

.planet-tab
  border 1px solid rgba(127, 127, 127, .35)
  background transparent
  color inherit
  border-radius 16px
  padding 3px 12px
  font-size .85em
  cursor pointer

.planet-tab-on
  background #1283c3
  border-color #1283c3
  color #fff

.planet-search
  border 1px solid rgba(127, 127, 127, .35)
  border-radius 16px
  padding 4px 12px
  font-size .85em
  background transparent
  color inherit
  width 160px

.planet-count
  font-size .82em
  opacity .7
  margin-bottom 12px

.planet-pin-zone
.planet-list
  display flex
  flex-direction column
  gap 14px

.planet-pin-zone
  margin-bottom 16px

.planet-card
  border 1px solid rgba(127, 127, 127, .28)
  border-radius 12px
  padding 14px 16px
  background rgba(127, 127, 127, .04)

.planet-card-pinned
  border-color #d93f0b

.planet-card-head
  display flex
  align-items center
  gap 10px
  margin-bottom 8px

.planet-avatar
  width 36px
  height 36px
  border-radius 50%

.planet-who
  display flex
  flex-direction column
  line-height 1.3

.planet-author
  font-weight 600
  font-size .92em

.planet-time
  font-size .78em
  opacity .65

.planet-badges
  margin-left auto
  display flex
  gap 6px

.planet-badge
  font-size .75em
  padding 2px 8px
  border-radius 10px

.planet-badge-pin
  background #d93f0b
  color #fff

.planet-badge-featured
  background #fbca04
  color #333

.planet-title
  display block
  font-weight 600
  font-size 1.05em
  margin-bottom 6px

.planet-body
  font-size .95em
  opacity .9
  margin-bottom 8px

.planet-cover-wrap
  margin-bottom 8px

.planet-cover img
  max-width 220px
  border-radius 8px
  display block

.planet-meta-row
  display flex
  flex-wrap wrap
  gap 6px
  margin-bottom 8px

.planet-chip
  border none
  background rgba(18, 131, 195, .12)
  color #1283c3
  border-radius 12px
  padding 2px 10px
  font-size .78em
  cursor pointer

.planet-chip-cat
  background rgba(217, 63, 11, .1)
  color #d93f0b

.planet-foot
  display flex
  align-items center
  gap 14px
  font-size .82em
  opacity .85

.planet-stat
  user-select none

.planet-link
  margin-left auto

.planet-stat + .planet-link
  margin-left 0

.planet-link-read
  margin-left auto

.planet-foot > .planet-link:first-of-type
  margin-left auto

.planet-empty
  text-align center
  opacity .6
  padding 30px 0
