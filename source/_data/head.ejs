<%
  const siteRoot = config.url.replace(/\/$/, '') + '/';
  const pagePath = page.path || '';
  const canonical = full_url_for(pagePath).replace(/index\.html$/, '');
  const title = page.title ? page.title + ' | ' + config.title : config.title;
  const rawDesc = page.description || (page.excerpt ? page.excerpt.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 120) : '') || config.description || '';
  const description = rawDesc.replace(/\s+/g, ' ').trim();
  const image = page.cover ? full_url_for(page.cover) : siteRoot + 'images/avatar.jpg';
  const isHome = pagePath === '' || pagePath === 'index.html';
  const isPost = page.layout === 'post';
  const published = page.date ? page.date.toISOString() : '';
  const modifiedDate = page.updated || page.date;
  const modified = modifiedDate ? modifiedDate.toISOString() : '';
  const author = page.author || config.author || config.title;

  let jsonLd;
  if (isPost) {
    jsonLd = {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: page.title,
      description: description,
      url: canonical,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      image: [image],
      datePublished: published,
      dateModified: modified,
      inLanguage: 'zh-CN',
      author: { '@type': 'Person', name: author },
      publisher: {
        '@type': 'Organization',
        name: config.title,
        logo: { '@type': 'ImageObject', url: siteRoot + 'images/avatar.jpg' }
      }
    };
  } else if (isHome) {
    jsonLd = {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: config.title,
      alternateName: config.subtitle || '',
      url: canonical,
      description: description,
      inLanguage: 'zh-CN'
    };
  } else {
    jsonLd = {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      url: canonical,
      description: description,
      inLanguage: 'zh-CN',
      isPartOf: { '@type': 'WebSite', name: config.title, url: siteRoot }
    };
  }
%>
<meta property="og:type" content="<%= isPost ? 'article' : 'website' %>">
<meta property="og:title" content="<%= page.title || config.title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:locale" content="zh_CN">
<meta property="og:image" content="<%= image %>">
<% if (isPost) { %>
<meta property="article:published_time" content="<%= published %>">
<meta property="article:modified_time" content="<%= modified %>">
<meta property="article:author" content="<%= author %>">
<% (page.tags && page.tags.length ? page.tags.toArray() : []).forEach(function(tag) { %>
<meta property="article:tag" content="<%= tag.name %>">
<% }) %>
<% } %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= page.title || config.title %>">
<meta name="twitter:description" content="<%= description %>">
<meta name="twitter:image" content="<%= image %>">
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
